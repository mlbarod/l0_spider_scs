# Defect SPIDER 이상감지 리스트 경로 설정. 값을 입력한 뒤 서버를 재시작하세요.
# /appdata/hadoop/code/eads/<Line>/<device>/fail_list.parquet
# 서버에 같은 환경변수가 이미 있으면 서버 환경변수를 우선합니다.
# Line별 device를 JSON으로 지정합니다. Line은 화면에서 선택하는 원래 Line 값입니다.
# 예시: DEFECT_SPIDER_LINE_DEVICES='{"P1L":"DEVICE_A","P2L":"DEVICE_B"}'
DEFECT_SPIDER_LINE_DEVICES='{}'
