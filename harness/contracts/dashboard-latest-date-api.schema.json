{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L0 Spider Dashboard Latest Date API Success Response",
  "description": "GET /api/dashboard-latest-date가 반환하는 최신 Dashboard 세부파일 이름 계약이다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "latestDate"],
  "properties": {
    "ok": {
      "const": true
    },
    "latestDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} (?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$",
      "description": "path/{latest_date}에서 선택한 최신 세부파일의 파일명이다."
    }
  }
}
