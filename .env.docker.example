# 이 파일에는 실제 비밀번호, token, 내부 host 값을 기록하지 않는다.
L0_SPIDER_IMAGE=l0-spider:local
L0_SPIDER_NODE_IMAGE=node:22-bookworm-slim

# 기본값은 같은 서버의 reverse proxy 또는 curl에서만 접근 가능하다.
L0_SPIDER_BIND_IP=127.0.0.1
L0_SPIDER_HOST_PORT=5173

# 기존 L0 Spider host 및 DB의 업무 timezone과 일치하는지 배포 전에 확인한다.
L0_SPIDER_TIMEZONE=Asia/Seoul

# Parquet 서버의 NFS/CIFS를 Docker host에 먼저 mount한 경로.
# 컨테이너에서는 기존 l0_spider와 동일하게 항상 /appdata로 읽기 전용 mount된다.
L0_SPIDER_APPDATA_PATH=/appdata

# Docker host에 별도로 둔 DB 접속정보 pickle 파일. Compose secret으로만 전달된다.
L0_SPIDER_DB_INFO_HOST_PATH=/etc/l0-spider/db_info.pkl

# host의 sensor 제외 설정 directory. 원자적 파일 교체를 보존하며 비밀정보를 넣지 않는다.
L0_SPIDER_SENSOR_CONFIG_DIR=./config
